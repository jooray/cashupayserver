# syntax=docker/dockerfile:1.6
#
# Production Dockerfile for CashuPayServer (BareBits fork).
#
# Two stages:
#   1. composer install in the upstream composer image (no PHP runtime needed).
#   2. runtime image based on php:8.3-apache with mod_php + mod_rewrite.
#
# Operators mount /var/www/html as a persistent volume; the entrypoint seeds
# the app source into it on first boot, after which the in-app auto-updater
# is the upgrade path. `docker pull` of a new tag is for OS/PHP refreshes;
# set CASHUPAY_AUTO_UPDATE_ENABLED=0 if you prefer immutable infrastructure.
#
# Companion files:
#   docker/entrypoint-production.sh — first-boot seed + cron loop + apache.
#   docker/production-vhost.conf    — Apache vhost that honours the in-repo .htaccess.
#   docker/docker-compose.yml       — compose file (build context is the repo root).
#   docs/docker-production.md       — operator guide.
#
# The application tree lives under app/ in the repository; the image flattens
# it to /usr/src/cashupayserver, the same layout the release zip installs.
# Build from the repo root: docker build -f docker/Dockerfile.production .

# ---- Stage 1: composer install --------------------------------------------
FROM composer:2 AS deps

WORKDIR /app
COPY app/composer.json app/composer.lock /app/

# --ignore-platform-reqs: lastguest/murmurhash carries a stale PHP 7 pin that
# runs fine on PHP 8.3. Mirrors the flag used by scripts/build-standalone.sh.
RUN composer install \
        --no-dev \
        --no-progress \
        --optimize-autoloader \
        --ignore-platform-reqs


# ---- Stage 2: runtime ------------------------------------------------------
FROM php:8.3-apache AS runtime

# PHP extensions used by the app: gmp (bitwasp/bitcoin), pdo_sqlite (storage).
# curl is needed for the HEALTHCHECK and is convenient for ops.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libgmp-dev \
        libsqlite3-dev \
        curl \
        ca-certificates; \
    docker-php-ext-install -j"$(nproc)" gmp pdo_sqlite; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Apache modules the in-repo .htaccess relies on.
RUN a2enmod rewrite headers expires deflate

# Apache vhost: DocumentRoot + AllowOverride All so .htaccess is honoured,
# logs piped to container stdout/stderr.
COPY docker/production-vhost.conf /etc/apache2/sites-available/000-default.conf

# Bake source into /usr/src/cashupayserver. The entrypoint copies it into
# /var/www/html on first boot, then leaves it alone so subsequent runs
# pick up auto-updater changes from the volume.
RUN mkdir -p /usr/src/cashupayserver
COPY --from=deps /app/vendor                                       /usr/src/cashupayserver/vendor/
COPY app/includes/                                                 /usr/src/cashupayserver/includes/
COPY app/assets/                                                   /usr/src/cashupayserver/assets/
COPY app/api-keys/                                                 /usr/src/cashupayserver/api-keys/
COPY app/images/                                                   /usr/src/cashupayserver/images/
COPY app/cashu-wallet-php/CashuWallet.php                          /usr/src/cashupayserver/cashu-wallet-php/CashuWallet.php
COPY app/cashu-wallet-php/bip39-english.txt                        /usr/src/cashupayserver/cashu-wallet-php/bip39-english.txt
COPY app/admin.php app/setup.php app/api.php app/payment.php app/receive.php app/cron.php \
     app/router.php app/index.php app/recover.php app/health.php app/pay.php \
     app/product-image.php app/update.php app/provision.php app/sso.php /usr/src/cashupayserver/
COPY app/.htaccess app/favicon.ico                                 /usr/src/cashupayserver/

# Fail the build if any entry point router.php dispatches to is missing or any
# literal require doesn't resolve — the same guard tests.yml applies to the
# standalone zip. health.php was absent from this image until this check
# existed, which silently broke /health (and with it the clean-URL probe).
COPY scripts/verify-plugin-build.php /usr/src/verify-plugin-build.php
RUN php /usr/src/verify-plugin-build.php /usr/src/cashupayserver \
        setup.php admin.php api.php router.php index.php health.php pay.php \
        product-image.php update.php provision.php sso.php recover.php \
        cron.php payment.php receive.php includes/database.php \
    && rm /usr/src/verify-plugin-build.php

# Entrypoint.
COPY docker/entrypoint-production.sh /usr/local/bin/cashupay-entrypoint.sh
RUN chmod +x /usr/local/bin/cashupay-entrypoint.sh

# Auto-update is opt-in, matching the upstream code (Updater::isAutoUpdateEnabled):
# enable it from the admin UI / onboarding wizard, or force it on for the whole
# deployment with CASHUPAY_AUTO_UPDATE_ENABLED=1 at runtime.
ENV CRON_INTERVAL_SECONDS=60 \
    TZ=UTC \
    CASHUPAY_DOCKER=1

EXPOSE 80

# Probe /setup.php with -L: pre-setup it returns 200; post-setup it 302s to
# admin → login, which -L follows to a final 200. We avoid '/' because on a
# fresh install before the schema is bootstrapped, index.php 500s while
# resolving Urls::setup() against the un-migrated config table.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsSL http://localhost/setup.php > /dev/null || exit 1

VOLUME ["/var/www/html"]

ENTRYPOINT ["/usr/local/bin/cashupay-entrypoint.sh"]
CMD ["apache2-foreground"]

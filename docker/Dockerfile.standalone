FROM wordpress:php8.2-apache

# Install PHP extensions needed by CashuPayServer. The base image already has pdo_sqlite
# (compiled in) and bcmath; only gmp is missing.
RUN apt-get update && apt-get install -y --no-install-recommends libgmp-dev unzip \
    && docker-php-ext-install gmp \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Third-party code fetched at build time is pinned to a tagged release and checked against
# a known SHA-256 before use. To upgrade, change the version and the hash together
# (WP-CLI publishes wp-cli-<version>.phar.sha256 next to each release).
ARG WP_CLI_VERSION=2.12.0
ARG WP_CLI_SHA256=ce34ddd838f7351d6759068d09793f26755463b4a4610a5a5c0a97b68220d85c
ARG SQLITE_PLUGIN_VERSION=3.0.2
ARG SQLITE_PLUGIN_SHA256=a7c506b95283e90544aa9dcf0096cb5a5eea4afd7d690ae350940a50654c8bfd

# Install WP-CLI
RUN curl -fsSL -o /tmp/wp-cli.phar \
        "https://github.com/wp-cli/wp-cli/releases/download/v${WP_CLI_VERSION}/wp-cli-${WP_CLI_VERSION}.phar" \
    && echo "${WP_CLI_SHA256}  /tmp/wp-cli.phar" | sha256sum -c - \
    && mv /tmp/wp-cli.phar /usr/local/bin/wp \
    && chmod +x /usr/local/bin/wp

# Download SQLite Database Integration plugin (release asset, not a moving branch)
RUN curl -fsSL -o /tmp/sqlite-plugin.zip \
        "https://github.com/WordPress/sqlite-database-integration/releases/download/v${SQLITE_PLUGIN_VERSION}/plugin-sqlite-database-integration.zip" \
    && echo "${SQLITE_PLUGIN_SHA256}  /tmp/sqlite-plugin.zip" | sha256sum -c - \
    && unzip -q /tmp/sqlite-plugin.zip -d /tmp/sqlite-plugin \
    && mv /tmp/sqlite-plugin/plugin-sqlite-database-integration /usr/src/sqlite-plugin \
    && test -f /usr/src/sqlite-plugin/db.copy \
    && rm -rf /tmp/sqlite-plugin /tmp/sqlite-plugin.zip

# Copy CashuPayServer source for standalone mode
COPY includes/ /opt/cashupayserver/includes/
COPY assets/ /opt/cashupayserver/assets/
COPY api-keys/ /opt/cashupayserver/api-keys/
COPY cashu-wallet-php/CashuWallet.php /opt/cashupayserver/cashu-wallet-php/CashuWallet.php
COPY cashu-wallet-php/bip39-english.txt /opt/cashupayserver/cashu-wallet-php/bip39-english.txt
COPY admin.php setup.php api.php payment.php receive.php cron.php router.php index.php /opt/cashupayserver/
COPY .htaccess manifest.json /opt/cashupayserver/

# Create data directory with the same Apache 2.2 + 2.4 protection files
# Database::createDataDirectory() writes (it only does so when it creates the folder).
RUN mkdir -p /opt/cashupayserver/data \
    && printf '%s\n' \
        '# Deny all access to this directory' \
        '<IfModule mod_authz_core.c>' \
        '    Require all denied' \
        '</IfModule>' \
        '<IfModule !mod_authz_core.c>' \
        '    Order deny,allow' \
        '    Deny from all' \
        '</IfModule>' > /opt/cashupayserver/data/.htaccess \
    && printf '%s' "<?php http_response_code(403); exit('Forbidden');" > /opt/cashupayserver/data/index.php \
    && chown -R www-data:www-data /opt/cashupayserver \
    && chmod 0700 /opt/cashupayserver/data

# Copy entrypoint
COPY docker/entrypoint-standalone.sh /usr/local/bin/cashupay-entrypoint.sh
RUN chmod +x /usr/local/bin/cashupay-entrypoint.sh

EXPOSE 80 8080

ENTRYPOINT ["/usr/local/bin/cashupay-entrypoint.sh"]
CMD ["apache2-foreground"]

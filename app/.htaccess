# CashuPayServer Apache Configuration

# Serve index.php as the directory index. Bare Apache's built-in DirectoryIndex
# is "index.html" only (index.php is added by distro config that many shared
# hosts don't apply), so without this a directory URL like
# https://example.com/cashupay/ would list files or 403 instead of running
# index.php — which is what redirects a fresh install into the setup wizard.
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # API Key Authorization - /api-keys/authorize -> api-keys/authorize.php
    RewriteRule ^api-keys/authorize$ api-keys/authorize.php [L,QSA]

    # API routing - route /api/v1/* to api.php (preserve full path)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/v1/(.*)$ api.php/api/v1/$1 [L,QSA]

    # Route /v1/* to api.php (BTCPay compatibility)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^v1/(.*)$ api.php/v1/$1 [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect sensitive files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to config files that hold secrets (SMTP password, keys,
# auto-update constants). Apache normally executes .php rather than serving it,
# but if PHP handling is ever misconfigured these would dump as plaintext.
<FilesMatch "^(user_config|config\.local)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block SQLite database files anywhere under the webroot. The data/ directory
# carries its own deny-all .htaccess; this is defense in depth for stray copies
# (backups, a data dir created before that file existed). Covers WAL/SHM/journal
# sidecar files, which hold the same payment data.
<FilesMatch "\.(sqlite|db)(-(wal|shm|journal))?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive directories
# Note: <Directory> doesn't work in .htaccess, use RewriteRule instead
<IfModule mod_rewrite.c>
    # Block PHP/script directories that should never be web-accessible
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^cashu-wallet-php/ - [F,L]
    RewriteRule ^mint-discovery/ - [F,L]
    RewriteRule ^btcpayserver-api-docs/ - [F,L]
    RewriteRule ^scripts/ - [F,L]
    RewriteRule ^docker/ - [F,L]
    RewriteRule ^docs/ - [F,L]
    RewriteRule ^\.claude/ - [F,L]

    # Clean-URL front controller (enables url_mode = 'clean').
    #
    # Route anything that is not a real file or directory through router.php,
    # which already dispatches extension-less paths: /admin, /admin/<view>,
    # /setup, /pay/{store}, /payment/{id}, /health, etc. Kept LAST so the
    # [F,L] blocks above and the /api/v1 rules near the top keep priority, and
    # so real files (assets, admin.php itself) are served directly and never
    # loop back through the rewrite.
    #
    # Requires mod_rewrite + AllowOverride. Hosts without them simply never
    # match this rule; the URL-mode probe then detects direct/router instead
    # and everything keeps working through .php or /router.php paths.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ router.php/$1 [L,QSA]
</IfModule>

# PHP settings (if allowed)
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# Compression
<IfModule mod_deflate.c>
    # Both JS MIME names: modern Debian/Apache mime.types serve .js as
    # text/javascript, older setups as application/javascript.
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# nginx + php-fpm test image for the e2e suite's `nginx` backend.
#
# One container per app instance (nginx and FPM together) keeps orchestration
# identical to the apache backend: one run, one log stream, one stop. A dead
# FPM surfaces as 502s in the instance log, which is enough signal for tests.
#
# Runtime only — app source and per-instance config (site conf rendered from
# the canonical docker/nginx-site.conf, FPM pool) are bind-mounted by
# tests/fixtures/webserver.py. Containers run as the host uid on the host
# network; all mutable nginx/FPM state lives on the /tmp tmpfs.
#
# Same version-drift rationale as Dockerfile.apache-test; opcache is ON here
# too (the php:*-fpm default), so file overwrites mid-run exercise the
# updater's opcache reset like a real FPM host does.
FROM php:8.3-fpm

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends nginx libgmp-dev libzip-dev; \
    docker-php-ext-install -j"$(nproc)" gmp bcmath zip; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Non-root-friendly main config: pid/temp under /tmp, logs to stdio, sites
# included from the directory the fixture mounts into.
COPY nginx-test.conf /etc/nginx/nginx.conf

COPY nginx-fpm-entrypoint.sh /usr/local/bin/nginx-fpm-entrypoint.sh
RUN chmod +x /usr/local/bin/nginx-fpm-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/nginx-fpm-entrypoint.sh"]
